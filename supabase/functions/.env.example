# Supabase injects SUPABASE_URL and project keys automatically in production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=
TELEGRAM_PROVIDER_TOKEN=
# Random private string used by Telegram to sign webhook deliveries.
TELEGRAM_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FILM_MODEL=gpt-5.6-terra
ALLOW_DEMO_AUTH=false
ADMIN_TELEGRAM_IDS=
ADMIN_TELEGRAM_USERNAMES=
ADMIN_ACCESS_TOKEN=
SCREEN_ACCESS_TOKEN=
CRON_ACCESS_TOKEN=
# Quiet hours are 22:00–09:00 in this timezone.
NOTIFICATION_TIMEZONE=Europe/Moscow

# Optional explicit webhook URL. If omitted, backend derives it from SUPABASE_URL.
TELEGRAM_WEBHOOK_URL=
